{
  "name": "svg-bundle-preflight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline batch release QA for SVG cut-file bundles.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "marketing": "npm run build && node scripts/generate-marketing-assets.mjs",
    "test": "npm run build && npm run package && node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-acceptance.mjs",
    "test:browser:ci": "BROWSER_MATRIX=ci node tests/browser-acceptance.mjs"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "playwright-core": "1.62.1"
  }
}
