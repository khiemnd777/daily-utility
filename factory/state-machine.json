{
  "version": 2,
  "control_plane": "codex",
  "state_ledger": "github_issue",
  "initial_state": "READY_FOR_BUILD",
  "happy_path": [
    "READY_FOR_BUILD",
    "APPROVED_BUILD",
    "BUILDING",
    "READY_FOR_RELEASE",
    "APPROVED_RELEASE",
    "PUBLISHED"
  ],
  "staged_release_path": [
    "READY_FOR_RELEASE",
    "APPROVED_RELEASE",
    "GUMROAD_PUBLISHED",
    "READY_FOR_REMAINING_CHANNELS",
    "APPROVED_REMAINING_CHANNELS",
    "PUBLISHED"
  ],
  "states": {
    "READY_FOR_BUILD": {
      "terminal": false,
      "approval_checkpoint": "build"
    },
    "APPROVED_BUILD": {
      "terminal": false,
      "approval_checkpoint": null
    },
    "BUILDING": {
      "terminal": false,
      "approval_checkpoint": null
    },
    "READY_FOR_RELEASE": {
      "terminal": false,
      "approval_checkpoint": "release"
    },
    "APPROVED_RELEASE": {
      "terminal": false,
      "approval_checkpoint": null
    },
    "GUMROAD_PUBLISHED": {
      "terminal": false,
      "approval_checkpoint": null
    },
    "READY_FOR_REMAINING_CHANNELS": {
      "terminal": false,
      "approval_checkpoint": "remaining_channels"
    },
    "APPROVED_REMAINING_CHANNELS": {
      "terminal": false,
      "approval_checkpoint": null
    },
    "PUBLISHED": {
      "terminal": true,
      "approval_checkpoint": null
    },
    "REJECTED": {
      "terminal": true,
      "approval_checkpoint": null
    }
  },
  "transitions": [
    {
      "from": "READY_FOR_BUILD",
      "event": "/approve",
      "to": "APPROVED_BUILD",
      "actor": "trusted_reviewer"
    },
    {
      "from": "READY_FOR_BUILD",
      "event": "/reject",
      "to": "REJECTED",
      "actor": "trusted_reviewer"
    },
    {
      "from": "APPROVED_BUILD",
      "event": "build_started",
      "to": "BUILDING",
      "actor": "factory"
    },
    {
      "from": "BUILDING",
      "event": "required_checks_passed",
      "to": "READY_FOR_RELEASE",
      "actor": "factory"
    },
    {
      "from": "READY_FOR_RELEASE",
      "event": "/approve",
      "to": "APPROVED_RELEASE",
      "actor": "trusted_reviewer"
    },
    {
      "from": "READY_FOR_RELEASE",
      "event": "/reject",
      "to": "REJECTED",
      "actor": "trusted_reviewer"
    },
    {
      "from": "READY_FOR_RELEASE",
      "event": "/request-changes",
      "to": "BUILDING",
      "actor": "trusted_reviewer"
    },
    {
      "from": "APPROVED_RELEASE",
      "event": "release_completed",
      "to": "PUBLISHED",
      "actor": "release_job"
    },
    {
      "from": "APPROVED_RELEASE",
      "event": "gumroad_release_completed",
      "to": "GUMROAD_PUBLISHED",
      "actor": "release_job"
    },
    {
      "from": "GUMROAD_PUBLISHED",
      "event": "remaining_channels_ready",
      "to": "READY_FOR_REMAINING_CHANNELS",
      "actor": "factory"
    },
    {
      "from": "READY_FOR_REMAINING_CHANNELS",
      "event": "/approve",
      "to": "APPROVED_REMAINING_CHANNELS",
      "actor": "trusted_reviewer"
    },
    {
      "from": "READY_FOR_REMAINING_CHANNELS",
      "event": "/request-changes",
      "to": "GUMROAD_PUBLISHED",
      "actor": "trusted_reviewer"
    },
    {
      "from": "APPROVED_REMAINING_CHANNELS",
      "event": "release_completed",
      "to": "PUBLISHED",
      "actor": "release_job"
    }
  ]
}
