{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khiemnd777/daily-utility/factory/schemas/publication.schema.json",
  "title": "Daily Utility Publication Evidence",
  "$defs": {
    "productId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount_cents"],
      "properties": {
        "currency": { "const": "USD" },
        "amount_cents": { "type": "integer", "minimum": 0 }
      }
    },
    "artifact": {
      "type": "string",
      "pattern": "^products/[a-z0-9-]+/.+\\.zip$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gumroadSale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "url",
        "price",
        "published_at",
        "delivered_artifact_sha256",
        "catalog_backlink_verified_at"
      ],
      "properties": {
        "channel": { "const": "gumroad" },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?:[a-z0-9-]+\\.)?gumroad\\.com/l/[a-z0-9]+(?:-[a-z0-9]+)*/?$"
        },
        "price": { "$ref": "#/$defs/price" },
        "published_at": { "type": "string", "format": "date-time" },
        "delivered_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "catalog_backlink_verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "lemonSqueezySale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "url",
        "price",
        "published_at",
        "delivered_artifact_sha256",
        "catalog_backlink_verified_at"
      ],
      "properties": {
        "channel": { "const": "lemon-squeezy" },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[a-z0-9-]+\\.lemonsqueezy\\.com/checkout/buy/[A-Za-z0-9-]+/?(?:\\?[^#]*)?$"
        },
        "price": { "$ref": "#/$defs/price" },
        "published_at": { "type": "string", "format": "date-time" },
        "delivered_artifact_sha256": { "$ref": "#/$defs/sha256" },
        "catalog_backlink_verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "url",
        "published_at",
        "gumroad_link_verified_at",
        "lemon_squeezy_link_verified_at"
      ],
      "properties": {
        "channel": { "const": "knasoftware" },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://knasoftware\\.com/sources/[a-z0-9]+(?:-[a-z0-9]+)*/?$"
        },
        "published_at": { "type": "string", "format": "date-time" },
        "gumroad_link_verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "lemon_squeezy_link_verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "product_id",
        "channel",
        "url",
        "price",
        "artifact",
        "artifact_sha256",
        "published_at"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "product_id": { "$ref": "#/$defs/productId" },
        "channel": { "const": "gumroad" },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?:[a-z0-9-]+\\.)?gumroad\\.com/l/[a-z0-9]+(?:-[a-z0-9]+)*/?$"
        },
        "price": { "$ref": "#/$defs/price" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "published_at": { "type": "string", "format": "date-time" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "product_id",
        "sales_channels",
        "catalog",
        "artifact",
        "artifact_sha256"
      ],
      "properties": {
        "schema_version": { "const": 2 },
        "product_id": { "$ref": "#/$defs/productId" },
        "sales_channels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/gumroadSale" },
              { "$ref": "#/$defs/lemonSqueezySale" }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": { "channel": { "const": "gumroad" } },
                "required": ["channel"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": { "channel": { "const": "lemon-squeezy" } },
                "required": ["channel"]
              }
            }
          ]
        },
        "catalog": { "$ref": "#/$defs/catalog" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  ]
}
