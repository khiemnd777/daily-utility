{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/khiemnd777/daily-utility/factory/schemas/publication.schema.json",
  "title": "Daily Utility Publication Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product_id",
    "channel",
    "url",
    "price",
    "artifact",
    "artifact_sha256",
    "published_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 64
    },
    "channel": { "const": "gumroad" },
    "url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?:[a-z0-9-]+\\.)?gumroad\\.com/l/[a-z0-9]+(?:-[a-z0-9]+)*/?$"
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "amount_cents"],
      "properties": {
        "currency": { "const": "USD" },
        "amount_cents": { "type": "integer", "minimum": 0 }
      }
    },
    "artifact": {
      "type": "string",
      "pattern": "^products/[a-z0-9-]+/.+\\.zip$"
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "published_at": { "type": "string", "format": "date-time" }
  }
}
